{
  "manifest_version": 3,
  "name": "ChessMate - Best Move",
  "version": "1.0.0",
  "description": "Shows the best move on chess.com using local Stockfish. For analysis and learning purposes.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.chess.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-chessmate": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle ChessMate arrows"
    }
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ChessMate"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/engine/*"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ]
}
